<?xml version="1.0" encoding="utf-8"?>
<!-- colors.xml - 颜色资源 -->
<!-- 定义应用中使用的颜色值，高对比度设计 -->
<resources>
    <!-- 主题颜色 -->
    <color name="primary">#FF1976D2</color>
    <color name="primary_dark">#FF0D47A1</color>
    <color name="primary_light">#FF64B5F6</color>

    <color name="secondary">#FFFFA000</color>
    <color name="secondary_dark">#FFFF8F00</color>
    <color name="secondary_light">#FFFFD54F</color>

    <!-- 背景和表面 -->
    <color name="background">#FF121212</color>
    <color name="surface">#FF1E1E1E</color>
